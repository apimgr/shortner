{{define "header"}}<header class="site-header" role="banner">
<a href="/" class="brand">{{if .Base.LogoURL}}<img src="{{.Base.LogoURL}}" srcset="{{.Base.LogoURL}}?width=50 50w, {{.Base.LogoURL}}?width=200 200w" sizes="(max-width: 600px) 50px, 200px" alt="{{.Base.SiteName}}">{{end}}{{.Base.SiteName}}</a>
<nav id="navigation" class="nav-links" aria-label="{{t .Base.Lang "nav.main_navigation"}}">
<a href="/"{{if eq .Base.CurrentPath "/"}} class="active" aria-current="page"{{end}}>{{t .Base.Lang "nav.home"}}</a>
<a href="/list"{{if eq .Base.CurrentPath "/list"}} class="active" aria-current="page"{{end}}>{{t .Base.Lang "nav.list"}}</a>
</nav>
<label for="nav-toggle" class="nav-toggle" aria-label="{{t .Base.Lang "nav.toggle_navigation"}}"><span class="sr-only">{{t .Base.Lang "nav.menu"}}</span><span aria-hidden="true">&#9776;</span></label>
<div class="header-actions">
<a href="/server/preferences" class="header-link">{{t .Base.Lang "header.preferences"}}</a>
<form method="POST" action="/server/theme" class="theme-toggle-form">
<input type="hidden" name="csrf_token" value="{{.Base.CSRFToken}}">
<input type="hidden" name="return_to" value="{{.Base.CurrentPath}}">
<button type="submit" class="theme-toggle" name="theme" value="{{nextTheme .Base.Theme}}">{{t .Base.Lang (printf "theme.%s" (nextTheme .Base.Theme))}}</button>
</form>
</div>
{{if .Base.OperatorHeader}}<div class="operator-header-content">{{.Base.OperatorHeader}}</div>{{end}}
</header>
{{end}}
