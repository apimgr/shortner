{{define "consent-preferences-dialog"}}<dialog id="consent-preferences-dialog" class="modal" aria-labelledby="consent-preferences-title">
<form method="POST" action="/server/consent" data-action="consent-preferences-form">
<input type="hidden" name="csrf_token" value="{{.Base.CSRFToken}}">
<input type="hidden" name="decision" value="custom">
<h2 id="consent-preferences-title">{{t .Base.Lang "cookie_consent.preferences_title"}}</h2>
<div class="form-group">
<label><input type="checkbox" checked disabled> {{t .Base.Lang "cookie_consent.essential"}} &mdash; {{.Base.CookieEssentialDescription}}</label>
</div>
<div class="form-group">
<label><input type="checkbox" name="preferences" value="1" checked> {{t .Base.Lang "cookie_consent.preferences"}} &mdash; {{.Base.CookiePreferencesDescription}}</label>
</div>
<div class="form-group">
<label><input type="checkbox" name="analytics" value="1"> {{t .Base.Lang "cookie_consent.analytics"}} &mdash; {{.Base.CookieAnalyticsDescription}}</label>
</div>
<div class="modal-actions">
<button type="button" class="btn btn-secondary" data-action="close-dialog">{{t .Base.Lang "common.cancel"}}</button>
<button type="submit" class="btn btn-primary">{{t .Base.Lang "cookie_consent.save_preferences"}}</button>
</div>
</form>
</dialog>
{{end}}
