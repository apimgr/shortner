{{define "layout"}}<!DOCTYPE html>
<html lang="{{.Base.Lang}}" dir="{{.Base.Dir}}" class="theme-{{.Base.Theme}}">
{{template "head" .}}
<body>
<a href="#main-content" class="skip-link">{{t .Base.Lang "a11y.skip_to_content"}}</a>
<a href="#navigation" class="skip-link">{{t .Base.Lang "a11y.skip_to_navigation"}}</a>
{{template "cookie-consent" .}}
{{template "announcements" .}}
{{template "pwa" .}}
<p id="offline-indicator" class="offline-indicator" aria-live="polite" hidden>{{t .Base.Lang "pwa.offline"}}</p>
<input type="checkbox" id="nav-toggle" class="nav-checkbox">
{{template "header" .}}
<main id="main-content" tabindex="-1">
<div class="container {{containerModifier .Base.CurrentPath}}">
{{template "content" .}}
</div>
</main>
{{template "footer" .}}
{{template "consent-preferences-dialog" .}}
{{template "toast-container" .}}
{{template "live-region" .}}
{{template "scripts" .}}
</body>
</html>
{{end}}
