{{define "content"}}<article class="list-page">
<h1>All Links</h1>
<p>Every link created on {{.Base.SiteName}} is public — there are no
accounts, so any short link's destination and click count are visible to
anyone who knows or finds its code.</p>

{{if .Links}}
<div class="table-wrapper">
<table>
<thead><tr><th>Short link</th><th>Destination</th><th>Clicks</th><th>Created</th></tr></thead>
<tbody>
{{range .Links}}
<tr>
<td><a href="/{{.ShortCode}}">{{.ShortCode}}</a></td>
<td class="long-string"><a href="{{.DestinationURL}}" rel="nofollow">{{.DestinationURL}}</a></td>
<td>{{.ClickCount}}</td>
<td>{{.CreatedAt}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{else}}<p>No links have been created yet.</p>{{end}}

<nav class="pagination" aria-label="Pagination">
{{if .HasPrev}}<a class="btn btn-secondary" href="/list?page={{.PrevPage}}">&laquo; Previous</a>{{end}}
<span>Page {{.Pagination.Page}} of {{.Pagination.Pages}}</span>
{{if .HasNext}}<a class="btn btn-secondary" href="/list?page={{.NextPage}}">Next &raquo;</a>{{end}}
</nav>
</article>
{{end}}
