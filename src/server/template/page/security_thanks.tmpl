{{define "content"}}{{$lang := .Base.Lang}}<article class="security-thanks-page">
<h1>{{t $lang "security.acknowledgments_title"}}</h1>

{{if .Thanks}}
<p>{{t $lang "security.thanks_intro"}}</p>
<ul class="security-thanks-list">
{{range .Thanks}}<li><strong>{{.Name}}</strong>{{if .Year}} &mdash; {{.Year}}{{end}}{{if .Credit}}: {{.Credit}}{{end}}</li>
{{end}}</ul>
{{else}}
<p>{{t $lang "security.no_acknowledgments"}}</p>
{{end}}

<p><a href="/server/security">{{t $lang "security.back_to_security"}}</a></p>
</article>
{{end}}
