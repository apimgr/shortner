{{define "content"}}{{$lang := .Base.Lang}}
<header class="page-header"><h1 class="page-title">{{t $lang "security.acknowledgments_title"}}</h1><p class="page-lead">{{t $lang "security.thanks_intro"}}</p></header>

{{if .Thanks}}
<section class="section-card" aria-labelledby="security-thanks-title"><h2 id="security-thanks-title">{{t $lang "security.thanks_intro"}}</h2><ul class="security-thanks-list">
{{range .Thanks}}<li><strong>{{.Name}}</strong>{{if .Year}} &mdash; {{.Year}}{{end}}{{if .Credit}}: {{.Credit}}{{end}}</li>
{{end}}</ul></section>
{{else}}
<p>{{t $lang "security.no_acknowledgments"}}</p>
{{end}}

<p><a href="/server/security">{{t $lang "security.back_to_security"}}</a></p>
{{end}}
