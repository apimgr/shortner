{{define "content"}}{{$lang := .Base.Lang}}<article class="security-page">
<h1>{{t $lang "security.title"}}</h1>

<p>{{tf $lang "security.intro" "site" .Base.SiteName}}</p>

<h2>{{t $lang "security.how_to_report"}}</h2>
<ol class="security-contacts">
{{if .ReportURL}}<li><strong>{{t $lang "security.private_report"}}</strong>
<a href="{{.ReportURL}}" rel="noopener">{{.ReportURL}}</a></li>{{end}}
{{if .ContactFormURL}}<li><strong>{{t $lang "security.report_form"}}</strong>
<a href="{{.ContactFormURL}}">{{t $lang "security.report_form_link"}}</a></li>{{end}}
{{if .ContactEmail}}<li><strong>{{t $lang "security.email"}}</strong>
<a href="mailto:{{.ContactEmail}}">{{.ContactEmail}}</a></li>{{end}}
</ol>

<h2>{{t $lang "security.what_to_include"}}</h2>
<p>{{t $lang "security.what_to_include_body"}}</p>

{{if .HasPGPKey}}
<h2>{{t $lang "security.encryption"}}</h2>
<p>{{t $lang "security.encryption_body"}}
<a href="{{.PGPKeyURL}}">{{.PGPKeyURL}}</a>{{if .Keyservers}}, {{t $lang "security.also_published"}}
{{range $i, $k := .Keyservers}}{{if $i}}, {{end}}<a href="{{$k}}" rel="noopener">{{$k}}</a>{{end}}{{end}}.</p>
{{end}}

<h2>{{t $lang "security.policy_heading"}}</h2>
<p>{{t $lang "security.policy_before"}} <a href="{{.PolicyURL}}">{{t $lang "security.policy_link"}}</a>
{{t $lang "security.policy_after"}} {{t $lang "security.thanks_before"}}
<a href="{{.ThanksURL}}">{{t $lang "security.thanks_link"}}</a>.</p>

<h2>{{t $lang "security.machine_readable"}}</h2>
<p>{{t $lang "security.mirrors"}} <a href="{{.SecurityTxtURL}}">{{.SecurityTxtURL}}</a>
{{tf $lang "security.rfc_note" "expires" .Expires}}</p>
</article>
{{end}}
