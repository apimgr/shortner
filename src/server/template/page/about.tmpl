{{define "content"}}
<header class="page-header"><h1 class="page-title">{{tf .Base.Lang "about.title_named" "site" .Base.SiteName}}</h1><p class="page-lead">{{t .Base.Lang "about.intro"}}</p></header>

<section class="section-card" aria-labelledby="about-who"><h2 id="about-who">{{t .Base.Lang "about.who_title"}}</h2>
<ul>
<li>{{t .Base.Lang "about.who_individuals"}}</li>
<li>{{t .Base.Lang "about.who_developers"}}</li>
<li>{{t .Base.Lang "about.who_sharers"}}</li>
</ul>
</section>

<section class="section-card" aria-labelledby="about-features"><h2 id="about-features">{{t .Base.Lang "about.features"}}</h2>
<ul>
<li><strong>{{t .Base.Lang "about.feature_shortening"}}</strong> &mdash; {{t .Base.Lang "about.feature_shortening_desc"}}</li>
<li><strong>{{t .Base.Lang "about.feature_redirect"}}</strong> &mdash; {{t .Base.Lang "about.feature_redirect_desc"}}</li>
<li><strong>{{t .Base.Lang "about.feature_analytics"}}</strong> &mdash; {{t .Base.Lang "about.feature_analytics_desc"}}</li>
<li><strong>{{t .Base.Lang "about.feature_management"}}</strong> &mdash; {{t .Base.Lang "about.feature_management_desc"}}</li>
<li><strong>{{t .Base.Lang "about.feature_no_accounts"}}</strong> &mdash; {{t .Base.Lang "about.feature_no_accounts_desc"}}</li>
</ul>
</section>

<section class="section-card" aria-labelledby="about-version"><h2 id="about-version">{{t .Base.Lang "about.version"}}</h2>
<p>{{.Base.ProjectVersion}} ({{.Base.BuildDateTime}})</p>
</section>

<section class="section-card" aria-labelledby="about-links"><h2 id="about-links">{{t .Base.Lang "about.links"}}</h2>
<ul>
<li><a href="{{.Base.RepoURL}}">{{t .Base.Lang "about.source_code"}}</a></li>
<li><a href="https://apimgr-shortner.readthedocs.io">{{t .Base.Lang "help.api_documentation"}}</a></li>
</ul>
</section>

{{if .AboutContent}}<div class="about-extra">{{.AboutContent}}</div>{{end}}

<section class="section-card" aria-labelledby="about-geoip"><h2 id="about-geoip">{{t .Base.Lang "about.geoip_title"}}</h2>
<p><a href="https://db-ip.com/">IP Geolocation by DB-IP</a></p>
</section>
{{end}}
