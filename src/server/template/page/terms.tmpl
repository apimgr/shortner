{{define "content"}}{{$lang := .Base.Lang}}
<header class="page-header"><h1 class="page-title">{{t $lang "terms.title"}}</h1><p class="page-lead">{{.Base.Description}}</p></header>

{{if .HasCustomContent}}
<div class="terms-custom">{{.Content}}</div>
{{else}}
<section class="section-card" aria-labelledby="terms-acceptance"><h2 id="terms-acceptance">{{t $lang "terms.acceptance_title"}}</h2>
<p>{{tf $lang "terms.acceptance_body" "site" .Base.SiteName}}</p>
</section>

<section class="section-card" aria-labelledby="terms-acceptable-use"><h2 id="terms-acceptable-use">{{t $lang "terms.acceptable_use"}}</h2>
<p>{{t $lang "terms.acceptable_use_body"}}</p>
</section>

<section class="section-card" aria-labelledby="terms-liability"><h2 id="terms-liability">{{t $lang "terms.liability_title"}}</h2>
<p>{{t $lang "terms.liability_body"}}</p>
</section>

<section class="section-card" aria-labelledby="terms-changes"><h2 id="terms-changes">{{t $lang "terms.changes_title"}}</h2>
<p>{{t $lang "terms.changes_body"}}</p>
</section>

<section class="section-card" aria-labelledby="terms-governing-law"><h2 id="terms-governing-law">{{t $lang "terms.governing_law"}}</h2>
<p>{{t $lang "terms.governing_law_body"}}</p>
</section>
{{end}}
</article>
{{end}}
