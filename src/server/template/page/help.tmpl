{{define "content"}}{{$lang := .Base.Lang}}
<header class="page-header"><h1 class="page-title">{{t $lang "help.title"}}</h1><p class="page-lead">{{t $lang "help.getting_started_intro"}}</p></header>

<section class="section-card" id="getting-started" aria-labelledby="help-start-title">
<h2 id="help-start-title">{{t $lang "help.getting_started"}}</h2>
<p>{{t $lang "help.getting_started_intro"}}</p>
<pre><code>curl -X POST {{.APIBaseURL}}/links \
  -H "Content-Type: application/json" \
  -d '{"url":"https://example.com/very/long/path"}'</code></pre>
<p>{{t $lang "help.response"}}</p>
<pre><code>{
  "short_code": "aZ3kQ1",
  "short_url": "{{.SiteOrigin}}/aZ3kQ1",
  "destination_url": "https://example.com/very/long/path",
  "created_at": "2026-08-07T00:00:00Z"
}</code></pre>
<p>{{t $lang "help.owner_token_note"}}</p>
</section>

<section class="section-card" id="features" aria-labelledby="help-features-title">
<h2 id="help-features-title">{{t $lang "help.features"}}</h2>

<h3>{{t $lang "help.custom_slugs"}}</h3>
<p>{{t $lang "help.custom_slugs_intro"}}</p>
<pre><code>curl -X POST {{.APIBaseURL}}/links \
  -H "Content-Type: application/json" \
  -d '{"url":"https://example.com","slug":"my-link"}'</code></pre>
<p>{{t $lang "help.slug_rules"}}</p>

<h3>{{t $lang "help.managing"}}</h3>
<p>{{t $lang "help.managing_intro"}}</p>
<pre><code>read -r -s -p "Owner token: " OWNER_TOKEN
printf '\n'
curl -X PATCH {{.APIBaseURL}}/links/my-link \
  -H "Authorization: Bearer $OWNER_TOKEN" \
  -d '{"destination_url":"https://example.com/new-path"}'

curl -X PATCH {{.APIBaseURL}}/links/my-link \
  -H "Authorization: Bearer $OWNER_TOKEN" \
  -d '{"expires_at":"2030-01-01T00:00:00Z"}'

curl -X PATCH {{.APIBaseURL}}/links/my-link \
  -H "Authorization: Bearer $OWNER_TOKEN" \
  -d '{"expires_at":null}'

curl -X DELETE {{.APIBaseURL}}/links/my-link \
  -H "Authorization: Bearer $OWNER_TOKEN"</code></pre>
<p>{{t $lang "about.feature_management_desc"}}</p>

<h3>{{t $lang "help.click_analytics"}}</h3>
<p>{{t $lang "help.analytics_intro"}}</p>
<pre><code>curl {{.SiteOrigin}}/my-link/stats -H "Accept: application/json"</code></pre>
<p>{{t $lang "help.analytics_note"}}</p>
</section>

<section class="section-card" aria-labelledby="help-api-title">
<h2 id="help-api-title">{{t $lang "help.api_documentation"}}</h2>
<p>{{t $lang "help.api_docs_body"}}</p>
<ul>
<li><a href="/server/docs/swagger">Swagger UI</a></li>
<li><a href="/server/docs/graphql">GraphiQL</a></li>
</ul>
</section>

{{if .Base.TorOnionAddress}}
<section class="section-card" id="tor-access" aria-labelledby="help-tor-title">
<h2 id="help-tor-title">{{t $lang "help.tor_access"}}</h2>
<p>{{t $lang "help.tor_intro"}}</p>
<h3>{{t $lang "help.onion_address"}}</h3>
<div class="code-block">
<code class="code-content">{{.Base.TorOnionAddress}}</code>
<button type="button" class="copy-btn" data-copy="{{.Base.TorOnionAddress}}" aria-label="{{t $lang "footer.copy_onion_address"}}">
<span class="copy-icon" aria-hidden="true">&#128203;</span>
<span class="copy-text">{{t $lang "common.copy"}}</span>
</button>
</div>
<h3>{{t $lang "help.how_to_connect"}}</h3>
<ol>
<li><a href="https://www.torproject.org/download/" target="_blank" rel="noopener">{{t $lang "help.download_tor"}}</a><span class="sr-only"> ({{t $lang "a11y.external_link"}})</span></li>
<li>{{t $lang "help.open_tor"}}</li>
<li>{{t $lang "help.paste_onion"}}</li>
</ol>
<p class="note">{{t $lang "help.tor_privacy"}}</p>
</section>
{{end}}

{{if .Base.I2PAddress}}
<section class="section-card" id="i2p-access" aria-labelledby="help-i2p-title">
<h2 id="help-i2p-title">{{t $lang "help.i2p_access"}}</h2>
<p>{{t $lang "help.i2p_intro"}}</p>
<h3>{{t $lang "help.i2p_address"}}</h3>
<div class="code-block">
<code class="code-content">{{.Base.I2PAddress}}</code>
<button type="button" class="copy-btn" data-copy="{{.Base.I2PAddress}}" aria-label="{{t $lang "footer.copy_i2p_address"}}">
<span class="copy-icon" aria-hidden="true">&#128203;</span>
<span class="copy-text">{{t $lang "common.copy"}}</span>
</button>
</div>
<h3>{{t $lang "help.how_to_connect"}}</h3>
<ol>
<li><a href="https://geti2p.net/en/download" target="_blank" rel="noopener">{{t $lang "help.download_i2p"}}</a><span class="sr-only"> ({{t $lang "a11y.external_link"}})</span></li>
<li>{{t $lang "help.open_i2p"}}</li>
<li>{{t $lang "help.paste_i2p"}}</li>
</ol>
<p class="note">{{t $lang "help.i2p_privacy"}}</p>
</section>
{{end}}

<section class="section-card" id="faq" aria-labelledby="help-faq-title">
<h2 id="help-faq-title">{{t $lang "help.faq"}}</h2>
<h3>{{t $lang "help.faq_account_q"}}</h3>
<p>{{t $lang "help.faq_account_a"}}</p>
<h3>{{t $lang "help.faq_rate_q"}}</h3>
<p>{{t $lang "help.faq_rate_a"}}</p>
<h3>{{t $lang "help.faq_expired_q"}}</h3>
<p>{{t $lang "help.faq_expired_a"}}</p>
</section>

<section class="section-card" id="troubleshooting" aria-labelledby="help-troubleshooting-title">
<h2 id="help-troubleshooting-title">{{t $lang "help.troubleshooting"}}</h2>
<h3>{{t $lang "help.ts_404_q"}}</h3>
<p>{{t $lang "help.ts_404_a"}}</p>
<h3>{{t $lang "help.ts_410_q"}}</h3>
<p>{{t $lang "help.ts_410_a"}}</p>
<h3>{{t $lang "help.ts_409_q"}}</h3>
<p>{{t $lang "help.ts_409_a"}}</p>
</section>
{{if .HelpContent}}<div class="help-extra">{{.HelpContent}}</div>{{end}}
<section class="section-card" aria-labelledby="more-help">
<h2 id="more-help">{{t $lang "help.more_help"}}</h2>
<ul class="hub-list">
{{range .HelpPages}}<li class="hub-item"><a class="hub-link" href="{{.Path}}"><span class="hub-title">{{.Title}}</span><span class="hub-desc">{{.Description}}</span></a></li>{{end}}
</ul>
</section>
</article>
{{end}}
