{{define "content"}}{{$lang := .Base.Lang}}<article class="help-page">
<h1>{{t $lang "help.title"}}</h1>

<section id="getting-started">
<h2>{{t $lang "help.getting_started"}}</h2>
<p>{{t $lang "help.getting_started_intro"}}</p>
<pre><code>curl -X POST {{.Base.SiteName}}/api/v1/links \
  -H "Content-Type: application/json" \
  -d '{"url":"https://example.com/very/long/path"}'</code></pre>
<p>{{t $lang "help.response"}}</p>
<pre><code>{
  "short_code": "aZ3kQ1",
  "short_url": "https://example.com/aZ3kQ1",
  "destination_url": "https://example.com/very/long/path",
  "owner_token": "tok_...",
  "created_at": "2026-08-07T00:00:00Z"
}</code></pre>
<p>{{t $lang "help.owner_token_note"}}</p>
</section>

<section id="features">
<h2>{{t $lang "help.features"}}</h2>

<h3>{{t $lang "help.custom_slugs"}}</h3>
<p>{{t $lang "help.custom_slugs_intro"}}</p>
<pre><code>curl -X POST {{.Base.SiteName}}/api/v1/links \
  -H "Content-Type: application/json" \
  -d '{"url":"https://example.com","slug":"my-link"}'</code></pre>
<p>{{t $lang "help.slug_rules"}}</p>

<h3>{{t $lang "help.managing"}}</h3>
<p>{{t $lang "help.managing_intro"}}</p>
<pre><code>curl -X PATCH {{.Base.SiteName}}/api/v1/links/my-link \
  -H "Authorization: Bearer tok_..." \
  -d '{"destination_url":"https://example.com/new-path"}'

curl -X DELETE {{.Base.SiteName}}/api/v1/links/my-link \
  -H "Authorization: Bearer tok_..."</code></pre>

<h3>{{t $lang "help.click_analytics"}}</h3>
<p>{{t $lang "help.analytics_intro"}}</p>
<pre><code>curl {{.Base.SiteName}}/my-link/stats -H "Accept: application/json"</code></pre>
<p>{{t $lang "help.analytics_note"}}</p>
</section>

<div class="api-docs">
<h3>{{t $lang "help.api_documentation"}}</h3>
<p>{{t $lang "help.api_docs_body"}}</p>
</div>

{{if .Base.TorOnionAddress}}
<section id="tor-access" class="tor-access">
<h3>{{t $lang "help.tor_access"}}</h3>
<p>{{t $lang "help.tor_intro"}}</p>
<h4>{{t $lang "help.onion_address"}}</h4>
<div class="code-block">
<code class="code-content">{{.Base.TorOnionAddress}}</code>
<button type="button" class="copy-btn" data-copy="{{.Base.TorOnionAddress}}" aria-label="{{t $lang "footer.copy_onion_address"}}">
<span class="copy-icon" aria-hidden="true">&#128203;</span>
<span class="copy-text">{{t $lang "common.copy"}}</span>
</button>
</div>
<h4>{{t $lang "help.how_to_connect"}}</h4>
<ol>
<li><a href="https://www.torproject.org/download/" target="_blank" rel="noopener">{{t $lang "help.download_tor"}}</a><span class="sr-only"> ({{t $lang "a11y.external_link"}})</span></li>
<li>{{t $lang "help.open_tor"}}</li>
<li>{{t $lang "help.paste_onion"}}</li>
</ol>
<p class="note">{{t $lang "help.tor_privacy"}}</p>
</section>
{{end}}

<section id="faq">
<h2>{{t $lang "help.faq"}}</h2>
<h3>{{t $lang "help.faq_account_q"}}</h3>
<p>{{t $lang "help.faq_account_a"}}</p>
<h3>{{t $lang "help.faq_rate_q"}}</h3>
<p>{{t $lang "help.faq_rate_a"}}</p>
<h3>{{t $lang "help.faq_expired_q"}}</h3>
<p>{{t $lang "help.faq_expired_a"}}</p>
</section>

<section id="troubleshooting">
<h2>{{t $lang "help.troubleshooting"}}</h2>
<h3>{{t $lang "help.ts_404_q"}}</h3>
<p>{{t $lang "help.ts_404_a"}}</p>
<h3>{{t $lang "help.ts_410_q"}}</h3>
<p>{{t $lang "help.ts_410_a"}}</p>
<h3>{{t $lang "help.ts_409_q"}}</h3>
<p>{{t $lang "help.ts_409_a"}}</p>
</section>
{{if .HelpContent}}<div class="help-extra">{{.HelpContent}}</div>{{end}}
</article>
{{end}}
