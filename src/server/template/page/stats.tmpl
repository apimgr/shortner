{{define "content"}}{{$lang := .Base.Lang}}
<header class="page-header"><h1 class="page-title">{{tf $lang "stats.title_named" "code" .Stats.ShortCode}}</h1><p class="page-lead">{{t $lang "stats.total_clicks"}}</p></header>

<div class="info-list">
<div class="info-row"><span class="info-label">{{t $lang "stats.destination"}}</span><span class="info-value"><a href="{{.DestinationURL}}" rel="nofollow noopener noreferrer">{{.DestinationURL}}</a></span></div>
<div class="info-row"><span class="info-label">{{t $lang "stats.total_clicks"}}</span><span class="info-value">{{.Stats.TotalClicks}}</span></div>
</div>

<section class="section-card" aria-labelledby="stats-by-day"><h2 id="stats-by-day">{{t $lang "stats.clicks_by_day"}}</h2>
{{if .Stats.TimeSeries}}
<div class="table-wrapper">
<table class="data-table">
<thead><tr><th>{{t $lang "stats.column_date"}}</th><th>{{t $lang "stats.column_clicks"}}</th></tr></thead>
<tbody>
{{range .Stats.TimeSeries}}<tr><td>{{.Date}}</td><td>{{.Count}}</td></tr>{{end}}
</tbody>
</table>
</div>
{{else}}<p>{{t $lang "stats.no_clicks"}}</p>{{end}}
</section>

<section class="section-card" aria-labelledby="stats-referrers"><h2 id="stats-referrers">{{t $lang "stats.top_referrers"}}</h2>
{{if .Stats.Referrers}}
<div class="table-wrapper">
<table class="data-table">
<thead><tr><th>{{t $lang "stats.column_referrer"}}</th><th>{{t $lang "stats.column_clicks"}}</th></tr></thead>
<tbody>
{{range $ref, $count := .Stats.Referrers}}<tr><td class="long-string">{{$ref}}</td><td>{{$count}}</td></tr>{{end}}
</tbody>
</table>
</div>
{{else}}<p>{{t $lang "stats.no_referrers"}}</p>{{end}}
</section>

<section class="section-card" aria-labelledby="stats-recent"><h2 id="stats-recent">{{t $lang "stats.recent_clicks"}}</h2>
{{if .Stats.Recent}}
<div class="table-wrapper">
<table class="data-table">
<thead><tr><th>{{t $lang "stats.column_time"}}</th><th>{{t $lang "stats.column_ip"}}</th><th>{{t $lang "stats.column_location"}}</th><th>{{t $lang "stats.column_referrer"}}</th></tr></thead>
<tbody>
{{range .Stats.Recent}}
<tr>
<td>{{.Timestamp}}</td>
<td class="monospace-data">{{.IP}}</td>
<td>{{if .Country}}{{.Country}}{{if .Region}}, {{.Region}}{{end}}{{else}}{{t $lang "stats.unknown"}}{{end}}</td>
<td class="long-string">{{if .Referrer}}{{.Referrer}}{{else}}{{t $lang "stats.direct"}}{{end}}</td>
</tr>
{{end}}
</tbody>
</table>
</div>
{{else}}<p>{{t $lang "stats.no_clicks"}}</p>{{end}}
</section>
{{end}}
