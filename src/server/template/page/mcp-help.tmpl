{{define "content"}}
<nav class="breadcrumb" aria-label="{{t .Base.Lang "common.breadcrumb"}}"><a href="/server/help">← {{t .Base.Lang "help.title"}}</a></nav>
<header class="page-header"><h1 class="page-title">{{t .Base.Lang "mcp.title"}}</h1><p class="page-lead">{{t .Base.Lang "mcp.subtitle"}}</p></header>
<section class="section-card" id="overview" aria-labelledby="mcp-overview"><h2 id="mcp-overview">{{t .Base.Lang "mcp.overview"}}</h2><p>{{.Overview}}</p></section>
<section class="section-card" id="endpoint" aria-labelledby="mcp-endpoint"><h2 id="mcp-endpoint">{{t .Base.Lang "mcp.endpoint"}}</h2><p>{{t .Base.Lang "mcp.canonical"}}</p><div class="code-block"><code class="copy-value">{{.URL}}</code><button type="button" class="copy-btn" data-copy="{{.URL}}" aria-label="{{t .Base.Lang "mcp.copy_endpoint"}}">{{t .Base.Lang "common.copy"}}</button></div><p>{{t .Base.Lang "mcp.aliases"}}: {{range $i, $url := .Aliases}}{{if $i}}, {{end}}<code>{{$url}}</code>{{end}}</p></section>
<section class="section-card" id="authentication" aria-labelledby="mcp-authentication"><h2 id="mcp-authentication">{{t .Base.Lang "mcp.authentication"}}</h2><p>{{.Authentication}}</p><p><a href="/server/preferences/tokens">{{t .Base.Lang "mcp.token_management"}}</a>.</p></section>
<section class="section-card" id="connect" aria-labelledby="mcp-connect"><h2 id="mcp-connect">{{t .Base.Lang "mcp.connect"}}</h2><p>{{.Connect}}</p><h3>{{t .Base.Lang "mcp.claude_code"}}</h3><div class="code-block"><pre><code>claude mcp add --transport http {{.ProjectName}} {{.URL}} --header "Authorization: Bearer $MCP_TOKEN"</code></pre><button type="button" class="copy-btn" data-copy="claude mcp add --transport http {{.ProjectName}} {{.URL}} --header &quot;Authorization: Bearer $MCP_TOKEN&quot;">{{t .Base.Lang "common.copy"}}</button></div><h3>{{t .Base.Lang "mcp.client_config"}}</h3><div class="code-block"><pre><code>{"mcpServers":{"{{.ProjectName}}":{"type":"http","url":"{{.URL}}","headers":{"Authorization":"Bearer $MCP_TOKEN"}}}}</code></pre><button type="button" class="copy-btn" data-copy="{&quot;mcpServers&quot;:{&quot;{{.ProjectName}}&quot;:{&quot;type&quot;:&quot;http&quot;,&quot;url&quot;:&quot;{{.URL}}&quot;,&quot;headers&quot;:{&quot;Authorization&quot;:&quot;Bearer $MCP_TOKEN&quot;}}}}">{{t .Base.Lang "common.copy"}}</button></div><h3>{{t .Base.Lang "mcp.verify"}}</h3><div class="code-block"><pre><code>curl -sS -H 'Accept: application/json' -H 'Content-Type: application/json' -H 'MCP-Protocol-Version: {{index .Versions 0}}' -H 'Mcp-Method: tools/list' -H "Authorization: Bearer $MCP_TOKEN" -d '{"jsonrpc":"2.0","id":1,"method":"tools/list","_meta":{"io.modelcontextprotocol/protocolVersion":"{{index .Versions 0}}"}}' '{{.URL}}'</code></pre><button type="button" class="copy-btn" data-copy="curl -sS -H 'Accept: application/json' -H 'Content-Type: application/json' -H 'MCP-Protocol-Version: {{index .Versions 0}}' -H 'Mcp-Method: tools/list' -H &quot;Authorization: Bearer $MCP_TOKEN&quot; -d '{&quot;jsonrpc&quot;:&quot;2.0&quot;,&quot;id&quot;:1,&quot;method&quot;:&quot;tools/list&quot;,&quot;_meta&quot;:{&quot;io.modelcontextprotocol/protocolVersion&quot;:&quot;{{index .Versions 0}}&quot;}}' '{{.URL}}'">{{t .Base.Lang "common.copy"}}</button></div></section>
<section class="section-card" id="tools" aria-labelledby="mcp-tools"><h2 id="mcp-tools">{{t .Base.Lang "mcp.tools"}}</h2><p>{{.ToolsInfo}}</p><ul>{{range .Tools}}<li><code>{{.Name}}</code> — {{.Description}}</li>{{else}}<li>{{t $.Base.Lang "mcp.no_tools"}}</li>{{end}}</ul></section>
<section class="section-card" id="limits" aria-labelledby="mcp-limits"><h2 id="mcp-limits">{{t .Base.Lang "mcp.limits"}}</h2><p>{{.Limits}}</p></section>
<section class="section-card" id="troubleshooting" aria-labelledby="mcp-troubleshooting"><h2 id="mcp-troubleshooting">{{t .Base.Lang "mcp.troubleshooting"}}</h2><div class="table-wrapper"><table class="data-table"><thead><tr><th scope="col">{{t .Base.Lang "mcp.status"}}</th><th scope="col">{{t .Base.Lang "mcp.problem"}}</th><th scope="col">{{t .Base.Lang "mcp.fix"}}</th></tr></thead><tbody>{{range .Errors}}<tr><th scope="row">{{.Status}}</th><td>{{.Problem}}</td><td>{{.Fix}}</td></tr>{{end}}</tbody></table></div></section>
{{if .Project}}<section class="section-card" id="project" aria-labelledby="mcp-project"><h2 id="mcp-project">{{.ProjectName}}</h2>{{.Project}}</section>{{end}}
{{end}}
