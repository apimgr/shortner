{{define "content"}}<article class="mcp-help">
<h1>{{t .Base.Lang "mcp.title"}}</h1>
<section id="overview"><h2>{{t .Base.Lang "mcp.overview"}}</h2><p>{{.Overview}}</p></section>
<section id="endpoint"><h2>{{t .Base.Lang "mcp.endpoint"}}</h2><p>{{t .Base.Lang "mcp.canonical"}}</p><div class="mcp-endpoint"><code class="mcp-endpoint-value">{{.URL}}</code><button type="button" class="copy-btn" data-copy="{{.URL}}" aria-label="{{t .Base.Lang "mcp.copy_endpoint"}}">{{t .Base.Lang "common.copy"}}</button></div><p>{{t .Base.Lang "mcp.aliases"}}: {{range $i, $url := .Aliases}}{{if $i}}, {{end}}<code>{{$url}}</code>{{end}}</p></section>
<section id="authentication"><h2>{{t .Base.Lang "mcp.authentication"}}</h2><p>{{.Authentication}}</p><p><a href="/server/preferences/tokens">{{t .Base.Lang "mcp.token_management"}}</a>.</p></section>
<section id="connect"><h2>{{t .Base.Lang "mcp.connect"}}</h2><p>{{.Connect}}</p><h3>{{t .Base.Lang "mcp.claude_code"}}</h3><pre><code>claude mcp add --transport http {{.ProjectName}} {{.URL}} --header "Authorization: Bearer $MCP_TOKEN"</code></pre><h3>{{t .Base.Lang "mcp.client_config"}}</h3><pre><code>{"mcpServers":{"{{.ProjectName}}":{"type":"http","url":"{{.URL}}","headers":{"Authorization":"Bearer $MCP_TOKEN"}}}}</code></pre><h3>{{t .Base.Lang "mcp.verify"}}</h3><pre><code>curl -sS -H 'Accept: application/json, text/event-stream' -H 'Content-Type: application/json' -H "Authorization: Bearer $MCP_TOKEN" -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"{{index .Versions 0}}","capabilities":{},"clientInfo":{"name":"mcp-check","version":"1"}}}' '{{.URL}}'</code></pre></section>
<section id="tools"><h2>{{t .Base.Lang "mcp.tools"}}</h2><p>{{.ToolsInfo}}</p><ul>{{range .Tools}}<li><code>{{.Name}}</code> — {{.Description}}</li>{{else}}<li>{{t $.Base.Lang "mcp.no_tools"}}</li>{{end}}</ul></section>
<section id="limits"><h2>{{t .Base.Lang "mcp.limits"}}</h2><p>{{.Limits}}</p></section>
<section id="troubleshooting"><h2>{{t .Base.Lang "mcp.troubleshooting"}}</h2><table><thead><tr><th>{{t .Base.Lang "mcp.status"}}</th><th>{{t .Base.Lang "mcp.problem"}}</th><th>{{t .Base.Lang "mcp.fix"}}</th></tr></thead><tbody>{{range .Errors}}<tr><th scope="row">{{.Status}}</th><td>{{.Problem}}</td><td>{{.Fix}}</td></tr>{{end}}</tbody></table></section>
{{if .Project}}<section id="project"><h2>{{.ProjectName}}</h2>{{.Project}}</section>{{end}}
</article>{{end}}
