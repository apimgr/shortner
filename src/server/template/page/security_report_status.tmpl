{{define "content"}}{{$lang := .Base.Lang}}
<header class="page-header"><h1 class="page-title">{{t $lang "security.report_status_title"}}</h1><p class="page-lead">{{t $lang "security.report_status_intro"}}</p></header>

<section class="section-card" aria-labelledby="report-status-details"><h2 id="report-status-details">{{t $lang "security.report_tracking_id"}}</h2><dl class="security-report-status">
<dt>{{t $lang "security.report_tracking_id"}}</dt><dd><code>{{.TrackingID}}</code></dd>
<dt>{{t $lang "security.report_state"}}</dt><dd>{{.StatusLabel}}</dd>
<dt>{{t $lang "security.report_severity"}}</dt><dd>{{.Severity}}</dd>
<dt>{{t $lang "security.report_component"}}</dt><dd>{{.Component}}</dd>
<dt>{{t $lang "security.report_received"}}</dt><dd>{{.ReceivedAt}}</dd>
{{if .DisclosureAt}}<dt>{{t $lang "security.report_disclosure_date"}}</dt><dd>{{.DisclosureAt}}</dd>{{end}}
</dl></section>

<section class="section-card" aria-labelledby="report-comments"><h2 id="report-comments">{{t $lang "security.report_comments"}}</h2>
{{if .Comments}}
{{range .Comments}}<p>{{.}}</p>
{{end}}
{{else}}
<p>{{t $lang "security.report_no_comments"}}</p>
{{end}}

<p>{{t $lang "security.report_status_once_per_day"}}</p>

<p><a href="{{.PolicyURL}}">{{t $lang "security.disclosure_policy_title"}}</a></p>
<p><a href="/server/security">{{t $lang "security.back_to_security"}}</a></p></section>
{{end}}
