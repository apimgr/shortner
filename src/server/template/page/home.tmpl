{{define "content"}}<section class="home-hero">
<img src="/favicon.ico" alt="" class="home-logo" width="96" height="96">
<h1>{{.Base.SiteName}}</h1>
<p class="tagline">{{.Base.Tagline}}</p>

{{if .Link}}
<div class="create-link-card success-card">
<h2 class="text-success">Success!</h2>
<div class="result-row">
<span class="result-label">Your short URL</span>
<div class="long-string monospace-data">
<a href="{{.Link.ShortURL}}">{{.Link.ShortURL}}</a>
<button type="button" class="copy-btn" data-copy="{{.Link.ShortURL}}" aria-label="Copy short URL to clipboard">
<span aria-hidden="true">&#128203;</span>
</button>
</div>
</div>
{{if .Link.OwnerToken}}
<div class="result-row">
<span class="result-label">Owner token — save this now, it will not be shown again</span>
<div class="long-string monospace-data api-token">{{.Link.OwnerToken}}</div>
</div>
{{end}}
<a href="/" class="btn btn-secondary">Create another</a>
</div>
{{else}}
<form method="POST" action="/" class="create-link-card" data-action="create-link-form" novalidate>
<input type="hidden" name="csrf_token" value="{{.Base.CSRFToken}}">
{{if .Error}}<p class="form-error" role="alert">{{.Error}}</p>{{end}}
<div class="form-group">
<label for="url">URL to shorten</label>
<input type="url" id="url" name="url" required placeholder="https://example.com/very/long/path" value="{{.Destination}}" class="input-field" aria-describedby="url-help">
<p id="url-help" class="field-help">Must be a full http(s) URL.</p>
</div>
<div class="form-group">
<label for="slug">Custom slug (optional)</label>
<input type="text" id="slug" name="slug" pattern="[A-Za-z0-9-]{3,20}" minlength="3" maxlength="20" placeholder="my-link" value="{{.CustomSlug}}" class="input-field" aria-describedby="slug-help">
<p id="slug-help" class="field-help">3-20 characters: letters, numbers, hyphens.</p>
</div>
<button type="submit" class="btn btn-primary">Shorten</button>
</form>
{{end}}
</section>
{{end}}
