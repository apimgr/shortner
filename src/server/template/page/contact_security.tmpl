{{define "content"}}{{$lang := .Base.Lang}}<article class="contact-page security-report-page">
<h1>{{t $lang "security_report.title"}}</h1>

{{if .Submitted}}
<p class="form-success" role="status">{{t $lang "security_report.received"}}</p>
<p class="tracking-id"><strong>{{t $lang "security_report.tracking_id"}}</strong> <code>{{.TrackingID}}</code></p>
<p>{{t $lang "security_report.encrypted_before"}}
<a href="/server/security/policy">{{t $lang "security_report.policy_link"}}</a>.</p>
{{else}}
<p>{{t $lang "security_report.form_intro_before"}}
<a href="/.well-known/security.txt">{{t $lang "security_report.security_txt_link"}}</a>,
{{t $lang "security_report.form_intro_after"}}</p>

<form method="POST" action="/server/contact" class="contact-form" novalidate>
<input type="hidden" name="csrf_token" value="{{.Base.CSRFToken}}">
<input type="hidden" name="security_id" value="{{.SecurityID}}">
{{if .Error}}<p class="form-error" role="alert">{{.Error}}</p>{{end}}

<div class="form-group">
<label for="name">{{t $lang "security_report.name"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<input type="text" id="name" name="name" required aria-required="true" class="input-field" value="{{.Form.Name}}">
</div>
<div class="form-group">
<label for="email">{{t $lang "security_report.email"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<input type="email" id="email" name="email" required aria-required="true" class="input-field" value="{{.Form.Email}}">
</div>
<div class="form-group">
<label for="researcher_gpg">{{t $lang "security_report.gpg_label"}} <span class="form-optional">{{t $lang "form.optional_field"}}</span></label>
<textarea id="researcher_gpg" name="researcher_gpg" class="input-field" rows="3"
  aria-describedby="researcher_gpg_help">{{.Form.ResearcherGPG}}</textarea>
<p id="researcher_gpg_help" class="form-help">{{t $lang "security_report.gpg_help"}}</p>
</div>

<div class="form-group">
<label for="component">{{t $lang "security_report.component"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<select id="component" name="component" required aria-required="true" class="input-field">
{{range .Components}}<option value="{{.}}"{{if eq . $.Form.Component}} selected{{end}}>{{.}}</option>{{end}}
</select>
</div>
<div class="form-group">
<label for="component_other">{{t $lang "security_report.component_other"}} <span class="form-optional">{{t $lang "form.optional_field"}}</span></label>
<input type="text" id="component_other" name="component_other" class="input-field">
</div>
<div class="form-group">
<label for="endpoint">{{t $lang "security_report.endpoint"}} <span class="form-optional">{{t $lang "form.optional_field"}}</span></label>
<input type="text" id="endpoint" name="endpoint" class="input-field" value="{{.Form.Endpoint}}">
</div>

<div class="form-group">
<label for="severity">{{t $lang "security_report.severity"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<select id="severity" name="severity" required aria-required="true" class="input-field">
{{range .Severities}}<option value="{{.}}"{{if eq . $.Form.Severity}} selected{{end}}>{{.}}</option>{{end}}
</select>
</div>

<div class="form-group">
<label for="summary">{{t $lang "security_report.summary"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<input type="text" id="summary" name="summary" required aria-required="true" class="input-field" value="{{.Form.Summary}}">
</div>
<div class="form-group">
<label for="steps">{{t $lang "security_report.steps"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<textarea id="steps" name="steps" required aria-required="true" class="input-field" rows="6">{{.Form.Steps}}</textarea>
</div>
<div class="form-group">
<label for="impact">{{t $lang "security_report.impact"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<textarea id="impact" name="impact" required aria-required="true" class="input-field" rows="4">{{.Form.Impact}}</textarea>
</div>
<div class="form-group">
<label for="suggested_fix">{{t $lang "security_report.suggested_fix"}} <span class="form-optional">{{t $lang "form.optional_field"}}</span></label>
<textarea id="suggested_fix" name="suggested_fix" class="input-field" rows="4">{{.Form.SuggestedFix}}</textarea>
</div>

<div class="form-group form-check">
<input type="checkbox" id="cve_requested" name="cve_requested" value="true"{{if .Form.CVERequested}} checked{{end}}>
<label for="cve_requested">{{t $lang "security_report.cve_request"}}</label>
</div>
<div class="form-group">
<label for="disclosure_days">{{t $lang "security_report.disclosure_days"}}</label>
<input type="number" id="disclosure_days" name="disclosure_days" min="1" class="input-field" value="{{.Form.DisclosureDays}}">
</div>
<div class="form-group">
<label for="credit_preference">{{t $lang "security_report.credit_preference"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<select id="credit_preference" name="credit_preference" required aria-required="true" class="input-field">
{{range .CreditPrefs}}<option value="{{.}}"{{if eq . $.Form.CreditPref}} selected{{end}}>{{.}}</option>{{end}}
</select>
</div>

<div class="form-group form-check">
<input type="checkbox" id="agreed_disclosure" name="agreed_disclosure" value="true" required aria-required="true"{{if .Form.AgreedDisclosure}} checked{{end}}>
<label for="agreed_disclosure">{{t $lang "security_report.agree_disclosure"}}</label>
</div>

<div class="form-group">
<label for="captcha">{{t $lang "contact.captcha_label"}} <span class="form-required">{{t $lang "form.required_field"}}</span></label>
<input type="text" id="captcha" name="captcha" required aria-required="true" class="input-field" autocomplete="off">
</div>

<button type="submit" class="btn btn-primary">{{t $lang "security_report.submit"}}</button>
</form>
{{end}}
</article>
{{end}}
